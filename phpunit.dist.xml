<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <env name="KERNEL_CLASS" value="App\Kernel" />
    </php>

    <testsuites>
        <testsuite name="Unit">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src/Auth</directory>
            <directory>src/Census</directory>
            <directory>src/Observation</directory>
            <directory>src/Analytics</directory>
            <directory>src/BirdCatalog</directory>
            <directory>src/Profile</directory>
            <directory>src/UI/Http</directory>
        </include>

        <exclude>
            <directory suffix="Exception.php">src</directory>
            <directory suffix="Interface.php">src</directory>
            <directory suffix="Repository.php">src</directory>
            <directory suffix="Type.php">src</directory>
            <directory suffix="ValueObject.php">src</directory>
            <directory suffix="Event.php">src</directory>
            <directory suffix="Request.php">src</directory>
            <directory suffix="Response.php">src</directory>

            <directory>src/Auth/Application/Mapper</directory>
            <directory>src/Auth/Infrastructure/Google</directory>
            <directory>src/Auth/Infrastructure/Console</directory>

            <directory>src/Census/Application/Mapper</directory>
            <file>src/Census/Domain/ValueObject/CensusDescription.php</file>
            <file>src/Census/Domain/ValueObject/CensusId.php</file>
            <file>src/Census/Domain/ValueObject/CensusLocationName.php</file>
            <file>src/Census/Domain/ValueObject/CensusTitle.php</file>
            <file>src/Census/Domain/ValueObject/CensusStatus.php</file>

            <directory>src/BirdCatalog/Application/Mapper</directory>
            <directory>src/BirdCatalog/Domain/ValueObject</directory>
            <directory>src/BirdCatalog/Infrastructure/DataFixtures</directory>

            <directory>src/Analytics/Application/Mapper</directory>
            <directory>src/Analytics/Domain/Event</directory>
            <directory>src/Analytics/Domain/ValueObject</directory>
            <directory>src/Analytics/Infrastructure/Persistence</directory>
            <directory>src/Analytics/Infrastructure/Event</directory>

            <directory>src/Notification/Domain/ValueObject</directory>
            <directory>src/Notification/Infrastructure/Firebase</directory>

            <file>src/Observation/Domain/ValueObject/ContactType.php</file>
            <file>src/Observation/Domain/ValueObject/LocationSource.php</file>
            <file>src/Observation/Domain/ValueObject/MoonPresence.php</file>
            <file>src/Observation/Domain/ValueObject/ObservationId.php</file>
            <file>src/Observation/Domain/ValueObject/RainLevel.php</file>
            <file>src/Observation/Domain/ValueObject/SessionType.php</file>
            <file>src/Observation/Domain/ValueObject/SkyCondition.php</file>
            <file>src/Observation/Domain/ValueObject/TemperatureRange.php</file>
            <file>src/Observation/Domain/ValueObject/VisibilityLevel.php</file>
            <file>src/Observation/Domain/ValueObject/WindLevel.php</file>
            <directory>src/Observation/Domain/Filter</directory>
            <directory>src/Observation/Infrastructure</directory>
            <directory>src/Observation/Application/Mapper</directory>

            <directory>src/Profile/Application/Mapper</directory>
            <file>src/Profile/Domain/ValueObject/ProfileId.php</file>

            <directory>src/Shared/Domain/Exception</directory>
            <file>src/Shared/Domain/ValueObject/AudioPath.php</file>
            <file>src/Shared/Domain/ValueObject/ImagePath.php</file>
            <directory>src/Shared/Infrastructure/Persistence</directory>

            <directory>src/UI/Http/Backoffice</directory>
            <directory>src/UI/Http/Public</directory>
        </exclude>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <coverage>
        <report>
            <html outputDirectory="coverage/html" />
            <clover outputFile="coverage/clover.xml" />
            <text outputFile="php://stdout" showUncoveredFiles="false" />
        </report>
    </coverage>
</phpunit>
