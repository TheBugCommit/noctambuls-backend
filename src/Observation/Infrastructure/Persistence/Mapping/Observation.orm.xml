<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Observation\Domain\Entity\Observation" table="observations">
        <id name="id" type="observation_id" length="36">
            <generator strategy="NONE"/>
        </id>
        <many-to-one field="session" target-entity="App\Observation\Domain\Entity\Session" inversed-by="observations">
            <join-column name="session_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <field name="speciesId" type="bird_id" column="species_id" length="36"/>
        <field name="contactType" type="contact_type" column="contact_type"/>
        <field name="quantity" type="observation_quantity" column="quantity"/>
        <field name="startTime" type="datetime_immutable" column="start_time"/>
        <field name="endTime" type="datetime_immutable" column="end_time"/>
        <field name="notes" type="text" column="notes" nullable="true"/>
        <field name="latitude" type="latitude" column="latitude" nullable="true"/>
        <field name="longitude" type="longitude" column="longitude" nullable="true"/>
        <field name="accuracy" type="accuracy" column="accuracy" nullable="true"/>
        <field name="altitude" type="altitude" column="altitude" nullable="true"/>
        <field name="altitudeAccuracy" type="altitude_accuracy" column="altitude_accuracy" nullable="true"/>
        <field name="locationSource" type="location_source" column="location_source" nullable="true"/>
        <field name="bearing" type="bearing" column="bearing"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>
    </entity>

</doctrine-mapping>
