{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'error.page.title'|trans }} ({{ status_code|default(500) }}){% endblock %}

{% block content %}
    {% set code = status_code|default(500) %}

    {% set config = code == 404
        ? { icon: 'lucide:file-question', color: 'text-warning', bg: 'bg-warning/10', border: 'border-warning/20' }
        : (code == 403
        ? { icon: 'lucide:shield-alert', color: 'text-error', bg: 'bg-error/10', border: 'border-error/20' }
        : { icon: 'lucide:triangle-alert', color: 'text-error', bg: 'bg-error/10', border: 'border-error/20' }) %}

    <div class="min-h-[70vh] flex items-center justify-center p-4">

        <div class="card w-full max-w-lg bg-base-100 shadow-2xl border border-base-200/60 relative overflow-hidden">

            <div
                class="absolute -top-12 -right-6 text-[12rem] font-black opacity-[0.03] pointer-events-none select-none leading-none">
                {{ code }}
            </div>

            <div class="card-body items-center text-center p-8 sm:p-10 z-10">

                <div
                    class="p-5 rounded-full {{ config.bg }} {{ config.color }} mb-6 border {{ config.border }} shadow-sm">
                    {{ ux_icon(config.icon, {class: 'w-12 h-12'}) }}
                </div>

                <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral mb-3">
                    <span class="{{ config.color }}">{{ code }}</span> - {{ 'error.page.heading'|trans }}
                </h1>

                <p class="text-base-content/70 text-base mb-8 max-w-sm leading-relaxed">
                    {{ 'error.page.description'|trans }}
                </p>

                <div
                    class="w-full text-left mb-8 bg-base-300/50 rounded-box border border-base-300 overflow-hidden shadow-inner">
                    <div class="bg-base-300 px-4 py-2 flex items-center gap-2 border-b border-base-300/50">
                        <div class="w-3 h-3 rounded-full bg-error/70"></div>
                        <div class="w-3 h-3 rounded-full bg-warning/70"></div>
                        <div class="w-3 h-3 rounded-full bg-success/70"></div>
                        <span class="text-xs font-mono ml-2 text-base-content/60">Developer Mode</span>
                    </div>
                    <div class="p-4 overflow-x-auto">
                        <pre
                            class="text-xs font-mono text-error/90 whitespace-pre-wrap leading-tight"><code>{{ status_text|default(exception.message|default('Error desconegut')) }}</code></pre>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 w-full mt-2">
                    <button onclick="window.history.back()"
                            class="btn btn-outline flex-1 flex items-center justify-center gap-2 hover:bg-base-200 hover:text-base-content hover:border-base-300 transition-colors">
                        {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4'}) }}
                        {{ 'error.action.back'|trans }}
                    </button>
                    <a href="{{ path('backoffice_session_list') }}"
                       class="btn btn-primary flex-1 flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all">
                        {{ ux_icon('lucide:home', {class: 'w-4 h-4'}) }}
                        {{ 'error.action.home'|trans }}
                    </a>
                </div>

            </div>
        </div>

    </div>
{% endblock %}
