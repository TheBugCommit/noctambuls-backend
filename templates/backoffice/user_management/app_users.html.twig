{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'user_management.app_users.title'|trans }}{% endblock %}
{% block page_title %}{{ 'user_management.nav.app_users'|trans }}{% endblock %}

{% block content %}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-neutral flex flex-wrap items-center gap-3">
                {{ ux_icon('lucide:users', {class: 'w-7 h-7 text-primary shrink-0'}) }}
                <span>{{ 'user_management.app_users.title'|trans }}</span>
                <span class="badge badge-primary badge-outline badge-lg text-sm font-bold shadow-sm shrink-0">
                    {{ total }}
                </span>
            </h1>
            <p class="text-base-content opacity-70 mt-1 text-sm">
                {{ 'user_management.app_users.description'|trans }}
            </p>
        </div>
    </div>

    {% if users is empty %}
        <div class="card bg-base-100 shadow-sm border border-base-200 py-16 text-center">
            <div class="flex flex-col items-center justify-center">
                <div class="p-4 bg-base-200/50 rounded-full text-base-content/30 mb-4">
                    {{ ux_icon('lucide:users', {class: 'w-12 h-12'}) }}
                </div>
                <h3 class="text-lg font-bold text-neutral mb-2">{{ 'user_management.app_users.empty'|trans }}</h3>
                <p class="text-base-content/60 max-w-sm text-sm">
                    {{ 'user_management.app_users.empty_description'|trans }}
                </p>
            </div>
        </div>
    {% else %}
        <div class="card bg-base-100 shadow-sm border border-base-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="table w-full">

                    <thead class="bg-base-200/50 text-neutral text-sm border-b border-base-200">
                    <tr>
                        <th>{{ 'user_management.field.name'|trans }} & {{ 'user_management.field.phone'|trans }}</th>
                        <th>{{ 'user_management.field.email'|trans }}</th>
                        <th>{{ 'user_management.field.registration_info'|trans }}</th>
                        <th>{{ 'user_management.field.status'|trans }}</th>
                        <th class="text-right w-40">{{ 'user_management.field.actions'|trans }}</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for user in users %}
                        <tr class="hover transition-colors border-b border-base-100 last:border-0 {{ user.isAnonymized ? 'opacity-70 bg-base-200/30' : '' }}">

                            <td>
                                <div class="flex flex-col gap-1">
                                    <span class="font-bold text-neutral">{{ user.name ?? '—' }}</span>
                                    <div class="flex items-center gap-1.5 text-xs text-base-content/70">
                                        {{ ux_icon('lucide:phone', {class: 'w-3 h-3 opacity-60'}) }}
                                        {{ user.phone ?? '—' }}
                                    </div>
                                </div>
                            </td>

                            <td class="max-w-[200px]">
                                <div class="tooltip tooltip-top" data-tip="{{ user.email }}">
                                    <div class="truncate text-left cursor-help font-medium max-w-[180px] sm:max-w-[200px]">
                                        {{ user.email }}
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="flex flex-col gap-1.5">
                                    <div class="flex items-center gap-1.5 text-sm">
                                            <span class="badge badge-outline badge-sm font-mono text-xs border-base-300">
                                                {{ user.ornithologistCode ?? 'user_management.app_users.no_code'|trans }}
                                            </span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-xs text-base-content/60">
                                        {{ ux_icon('lucide:calendar-days', {class: 'w-3 h-3'}) }}
                                        {{ user.createdAt|format_datetime }}
                                    </div>
                                </div>
                            </td>

                            <td>
                                {% if user.isAnonymized %}
                                    <span class="badge badge-error badge-sm font-medium gap-1">{{ 'user_management.status.anonymized'|trans }}</span>
                                {% elseif user.isBlocked %}
                                    <span class="badge badge-warning badge-sm font-medium gap-1">{{ 'user_management.status.blocked'|trans }}</span>
                                {% else %}
                                    <span class="badge badge-success badge-sm font-medium gap-1">{{ 'user_management.status.active'|trans }}</span>
                                {% endif %}
                            </td>

                            <td class="text-right">
                                {% if not user.isAnonymized %}
                                    <div class="flex justify-end gap-2">

                                        {% if user.isBlocked %}
                                            <form method="post"
                                                  action="{{ path('backoffice_users_unblock', {id: user.id}) }}"
                                                  class="inline"
                                                  data-controller="confirm-action"
                                                  data-confirm-action-message-value="{{ 'user_management.confirm.unblock'|trans }}">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_unblock_' ~ user.id) }}">
                                                <div class="tooltip tooltip-left sm:tooltip-top" data-tip="{{ 'user_management.action.unblock'|trans }}">
                                                    <button type="submit"
                                                            class="btn btn-ghost btn-sm btn-square flex items-center justify-center text-success hover:bg-success/10"
                                                            data-action="confirm-action#confirm">
                                                        {{ ux_icon('lucide:unlock', {class: 'w-4.5 h-4.5'}) }}
                                                    </button>
                                                </div>
                                            </form>
                                        {% else %}
                                            <form method="post"
                                                  action="{{ path('backoffice_users_block', {id: user.id}) }}"
                                                  class="inline"
                                                  data-controller="confirm-action"
                                                  data-confirm-action-message-value="{{ 'user_management.confirm.block'|trans }}">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_block_' ~ user.id) }}">
                                                <div class="tooltip tooltip-left sm:tooltip-top" data-tip="{{ 'user_management.action.block'|trans }}">
                                                    <button type="submit"
                                                            class="btn btn-ghost btn-sm btn-square flex items-center justify-center text-warning hover:bg-warning/10"
                                                            data-action="confirm-action#confirm">
                                                        {{ ux_icon('lucide:lock', {class: 'w-4.5 h-4.5'}) }}
                                                    </button>
                                                </div>
                                            </form>
                                        {% endif %}

                                        <form method="post"
                                              action="{{ path('backoffice_users_delete', {id: user.id}) }}"
                                              class="inline"
                                              data-controller="confirm-action"
                                              data-confirm-action-message-value="{{ 'user_management.confirm.anonymize'|trans }}">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_delete_' ~ user.id) }}">
                                            <div class="tooltip tooltip-left sm:tooltip-top" data-tip="{{ 'user_management.action.anonymize'|trans }}">
                                                <button type="submit"
                                                        class="btn btn-ghost btn-sm btn-square flex items-center justify-center text-error hover:bg-error/10"
                                                        data-action="confirm-action#confirm">
                                                    {{ ux_icon('lucide:user-x', {class: 'w-4.5 h-4.5'}) }}
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                {% else %}
                                    <span class="text-xs text-base-content/40 italic">{{ 'user_management.app_users.no_actions'|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if totalPages > 1 %}
            <div class="flex justify-center mt-8">
                <div class="join shadow-sm border border-base-200">
                    {% if page > 1 %}
                        <a href="{{ path('backoffice_users_list', {page: page - 1}) }}"
                           class="join-item btn btn-sm bg-base-100 hover:bg-base-200">
                            {{ ux_icon('lucide:chevron-left', {class: 'w-4 h-4'}) }}
                        </a>
                    {% endif %}

                    {% for p in 1..totalPages %}
                        <a href="{{ path('backoffice_users_list', {page: p}) }}"
                           class="join-item btn btn-sm {{ p == page ? 'btn-primary' : 'bg-base-100 hover:bg-base-200' }}">
                            {{ p }}
                        </a>
                    {% endfor %}

                    {% if page < totalPages %}
                        <a href="{{ path('backoffice_users_list', {page: page + 1}) }}"
                           class="join-item btn btn-sm bg-base-100 hover:bg-base-200">
                            {{ ux_icon('lucide:chevron-right', {class: 'w-4 h-4'}) }}
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
