{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'user_management.backoffice_users.title'|trans }}{% endblock %}
{% block page_title %}{{ 'user_management.nav.backoffice_users'|trans }}{% endblock %}

{% block content %}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-neutral flex items-center gap-3">
                {{ ux_icon('lucide:user-cog', {class: 'w-7 h-7 text-primary'}) }}
                {{ 'user_management.backoffice_users.title'|trans }}
            </h1>
            <p class="text-base-content opacity-70 mt-1 text-sm">
                {{ 'user_management.backoffice_users.description'|trans }}
            </p>
        </div>

        <a href="{{ path('backoffice_backoffice_users_create') }}" class="btn btn-primary btn-sm flex items-center gap-2 shadow-sm">
            {{ ux_icon('lucide:user-plus', {class: 'w-4 h-4'}) }}
            {{ 'user_management.action.create_backoffice_user'|trans }}
        </a>
    </div>

    {% if users is empty %}
        <div class="card bg-base-100 shadow-sm border border-base-200 py-16 text-center">
            <div class="flex flex-col items-center justify-center">
                <div class="p-4 bg-base-200/50 rounded-full text-base-content/30 mb-4">
                    {{ ux_icon('lucide:users', {class: 'w-12 h-12'}) }}
                </div>
                <h3 class="text-lg font-bold text-neutral mb-2">{{ 'user_management.backoffice_users.empty'|trans }}</h3>
                <p class="text-base-content/60 max-w-sm text-sm mb-6">
                    {{ 'user_management.backoffice_users.empty_description'|trans }}
                </p>
                <a href="{{ path('backoffice_backoffice_users_create') }}" class="btn btn-outline btn-primary btn-sm">
                    {{ ux_icon('lucide:user-plus', {class: 'w-4 h-4'}) }}
                    {{ 'user_management.action.create_backoffice_user'|trans }}
                </a>
            </div>
        </div>
    {% else %}
        <div class="card bg-base-100 shadow-sm border border-base-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="table w-full">

                    <thead class="bg-base-200/50 text-neutral text-sm border-b border-base-200">
                    <tr>
                        <th>{{ 'user_management.field.email'|trans }}</th>
                        <th>{{ 'user_management.field.role'|trans }}</th>
                        <th>{{ 'user_management.field.created_at'|trans }}</th>
                        <th class="text-right w-32">{{ 'user_management.field.actions'|trans }}</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for user in users %}
                        <tr class="hover transition-colors border-b border-base-100 last:border-0">

                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="avatar placeholder hidden sm:flex">
                                        <div class="bg-base-200 text-base-content/60 rounded-full w-9 border border-base-300">
                                            <span class="text-xs font-bold uppercase">{{ user.email|slice(0, 2) }}</span>
                                        </div>
                                    </div>

                                    <div class="tooltip tooltip-right" data-tip="{{ user.email }}">
                                        <div class="font-medium text-neutral truncate max-w-[180px] sm:max-w-xs cursor-help">
                                            {{ user.email }}
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                {% if user.role == 'ROLE_ADMIN' %}
                                    <span class="badge badge-primary badge-sm font-medium gap-1.5">
                                            {{ 'user_management.role.admin'|trans }}
                                        </span>
                                {% else %}
                                    <span class="badge badge-secondary badge-sm font-medium gap-1.5">
                                            {{ 'user_management.role.reviewer'|trans }}
                                        </span>
                                {% endif %}
                            </td>

                            <td>
                                <div class="flex items-center gap-2 text-sm text-base-content/80">
                                    {{ ux_icon('lucide:calendar-days', {class: 'w-4 h-4 opacity-50'}) }}
                                    <span>{{ user.createdAt|format_datetime }}</span>
                                </div>
                            </td>

                            <td class="text-right">
                                <div class="flex justify-end gap-2">
                                    <div class="tooltip tooltip-left sm:tooltip-top" data-tip="{{ 'user_management.action.edit'|trans }}">
                                        <a href="{{ path('backoffice_backoffice_users_edit', {id: user.id}) }}"
                                           class="btn btn-ghost btn-sm btn-square flex items-center justify-center text-neutral hover:text-primary">
                                            {{ ux_icon('lucide:pencil', {class: 'w-4.5 h-4.5'}) }}
                                        </a>
                                    </div>

                                    <form method="post"
                                          action="{{ path('backoffice_backoffice_users_delete', {id: user.id}) }}"
                                          class="inline"
                                          data-controller="confirm-action"
                                          data-confirm-action-message-value="{{ 'user_management.confirm.delete_backoffice_user'|trans }}">
                                        <input type="hidden" name="_csrf_token"
                                               value="{{ csrf_token('backoffice_user_delete_' ~ user.id) }}">
                                        <div class="tooltip tooltip-left sm:tooltip-top" data-tip="{{ 'user_management.action.delete'|trans }}">
                                            <button type="submit"
                                                    class="btn btn-ghost btn-sm btn-square flex items-center justify-center text-error hover:bg-error/10"
                                                    data-action="confirm-action#confirm">
                                                {{ ux_icon('lucide:trash-2', {class: 'w-4.5 h-4.5'}) }}
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
