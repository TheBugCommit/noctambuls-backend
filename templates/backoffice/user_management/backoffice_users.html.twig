{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'user_management.backoffice_users.title'|trans }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">{{ 'user_management.backoffice_users.title'|trans }}</h1>
    <a href="{{ path('backoffice_backoffice_users_create') }}" class="btn btn-primary btn-sm">
        + {{ 'user_management.action.create_backoffice_user'|trans }}
    </a>
</div>

{% if users is empty %}
    <div class="alert alert-info">
        <span>{{ 'user_management.backoffice_users.empty'|trans }}</span>
    </div>
{% else %}
    <div class="overflow-x-auto">
        <table class="table table-zebra w-full table-fixed bg-base-100 shadow-sm rounded-box">
            <thead>
                <tr>
                    <th>{{ 'user_management.field.email'|trans }}</th>
                    <th>{{ 'user_management.field.role'|trans }}</th>
                    <th>{{ 'user_management.field.created_at'|trans }}</th>
                    <th class="text-right">{{ 'user_management.field.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td class="font-medium max-w-xs">
                            <div class="tooltip tooltip-right" data-tip="{{ user.email }}">
                                <div class="truncate w-full text-left cursor-help">
                                    {{ user.email }}
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if user.role == 'ROLE_ADMIN' %}
                                <span class="badge badge-primary badge-sm">{{ 'user_management.role.admin'|trans }}</span>
                            {% else %}
                                <span class="badge badge-secondary badge-sm">{{ 'user_management.role.reviewer'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="text-sm">{{ user.createdAt }}</td>
                        <td class="text-right">
                            <a href="{{ path('backoffice_backoffice_users_edit', {id: user.id}) }}"
                               class="btn btn-ghost btn-xs">
                                {{ 'user_management.action.edit'|trans }}
                            </a>
                            <form method="post"
                                  action="{{ path('backoffice_backoffice_users_delete', {id: user.id}) }}"
                                  class="inline"
                                  onsubmit="return confirm('{{ 'user_management.confirm.delete_backoffice_user'|trans|e('js') }}')">
                                <input type="hidden" name="_csrf_token"
                                       value="{{ csrf_token('backoffice_user_delete_' ~ user.id) }}">
                                <button type="submit" class="btn btn-ghost btn-xs text-error">
                                    {{ 'user_management.action.delete'|trans }}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
