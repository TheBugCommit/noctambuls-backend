{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'session.detail.title'|trans }} #{{ session.id|slice(0,8) }}{% endblock %}
{% block page_title %}{{ 'session.nav'|trans }}{% endblock %}

{% block content %}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
            <a href="{{ path('backoffice_session_list') }}" class="btn btn-ghost btn-sm btn-circle text-neutral">
                {{ ux_icon('lucide:arrow-left', {class: 'w-5 h-5'}) }}
            </a>
            <h1 class="text-2xl md:text-3xl font-bold text-neutral">{{ 'session.detail.title'|trans }}</h1>
            <span class="badge badge-outline font-mono text-xs opacity-70">#{{ session.id|slice(0,8) }}</span>

            {% if session.isDeleted %}
                <span class="badge badge-error badge-sm font-semibold">{{ 'session.status.deleted'|trans }}</span>
            {% endif %}
        </div>
    </div>

    <form method="post" id="edit-session-form" action="{{ path('backoffice_session_detail', {id: session.id}) }}"
          class="space-y-6">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('session_edit') }}">

        <div class="card bg-base-200 border border-base-300 rounded-box shadow-sm">
            <div class="card-body p-6">
                <h2 class="card-title text-lg md:text-xl font-bold text-neutral mb-4 flex items-center gap-2">
                    {{ ux_icon('lucide:info', {class: 'w-5 h-5 text-primary'}) }}
                    {{ 'session.detail.section_info'|trans }}
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                    <div class="form-control w-full">
                        <label class="label py-1">
                            <span
                                class="label-text text-sm font-semibold text-neutral opacity-70">{{ 'session.detail.fields.user'|trans }}</span>
                        </label>
                        <input type="text" value="{{ session.annotatorName }}" readonly
                               class="input input-bordered input-md w-full bg-base-300 cursor-not-allowed text-neutral text-base"/>
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1">
                            <span
                                class="label-text text-sm font-semibold text-neutral opacity-70">{{ 'session.list.columns.type'|trans }}</span>
                        </label>
                        {% set typeConfig = session.sessionType|session_type_config %}
                        <div
                            class="input input-bordered input-md w-full bg-base-300 flex items-center gap-2 cursor-not-allowed text-neutral text-base">
                            {{ ux_icon(typeConfig.icon, {class: 'w-4 h-4 text-primary'}) }}
                            <span class="font-medium">{{ ('session.type.' ~ typeConfig.key)|trans }}</span>
                        </div>
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1">
                            <span class="label-text text-sm font-semibold text-neutral opacity-70">{{ 'session.list.columns.start_time'|trans }}</span>
                        </label>
                        <div class="input input-bordered input-md w-full bg-base-300 flex items-center justify-between cursor-not-allowed text-neutral text-base font-mono">
                            <span>{{ session.startTime ? session.startTime|format_datetime }}</span>
                            {{ ux_icon('lucide:calendar-clock', {class: 'w-4 h-4 opacity-60 text-primary'}) }}
                        </div>
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1">
                            <span class="label-text text-sm font-semibold text-neutral opacity-70">{{ 'session.detail.fields.end_time'|trans }}</span>
                        </label>
                        <div class="input input-bordered input-md w-full bg-base-300 flex items-center justify-between cursor-not-allowed text-neutral text-base font-mono">
                            <span>{{ session.endTime ? session.endTime|format_datetime }}</span>
                            {{ ux_icon('lucide:calendar-clock', {class: 'w-4 h-4 opacity-60 text-primary'}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-base-200 border border-base-300 rounded-box shadow-sm">
            <div class="card-body p-6">
                <h2 class="card-title text-lg md:text-xl font-bold text-neutral mb-4 flex items-center gap-2">
                    {{ ux_icon('lucide:cloud-sun', {class: 'w-5 h-5 text-primary'}) }}
                    {{ 'session.detail.section_environmental'|trans }}
                </h2>

                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                    {% set env_fields = [
                        { name: 'temperature', icon: 'lucide:thermometer', val: session.temperature },
                        { name: 'wind', icon: 'lucide:wind', val: session.wind },
                        { name: 'sky', icon: 'lucide:cloud', val: session.sky },
                        { name: 'rain', icon: 'lucide:cloud-rain', val: session.rain },
                        { name: 'visibility', icon: 'lucide:eye', val: session.visibility },
                        { name: 'moon', icon: 'lucide:moon', val: session.moon }
                    ] %}

                    {% for field in env_fields %}
                        <div class="form-control w-full">
                            <label class="label py-1 flex items-center gap-1.5">
                                {{ ux_icon(field.icon, {class: 'w-3.5 h-3.5 text-neutral opacity-70'}) }}
                                <span
                                    class="label-text text-sm font-semibold text-neutral opacity-70">{{ ('session.detail.fields.' ~ field.name)|trans }}</span>
                            </label>
                            <select name="{{ field.name }}"
                                    class="select select-bordered select-md w-full text-base bg-base-100 text-neutral font-medium">
                                {% for val, label_key in env_options(field.name) %}
                                    <option value="{{ val }}" {{ field.val is same as(val) ? 'selected' : '' }}>
                                        {{ label_key|trans }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {% if(session.sessionType != 0) %}
        <div class="card bg-base-200 border border-base-300 rounded-box shadow-sm">
            <div class="card-body p-6">
                <h2 class="card-title text-lg md:text-xl font-bold text-neutral mb-4 flex items-center gap-2">
                    {{ ux_icon('lucide:map-pin', {class: 'w-5 h-5 text-primary'}) }}
                    {{ 'session.detail.section_location'|trans }}
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                    <div class="form-control w-full">
                        <label class="label py-1">
                            <span
                                class="label-text text-sm font-semibold text-neutral opacity-70">{{ 'session.detail.fields.latitude'|trans }}</span>
                        </label>
                        <input type="text" value="{{ session.latitude|dash_if_empty }}"
                               class="input input-bordered input-md w-full bg-base-300 cursor-not-allowed text-neutral text-base font-mono"
                               readonly>
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1">
                            <span
                                class="label-text text-sm font-semibold text-neutral opacity-70">{{ 'session.detail.fields.longitude'|trans }}</span>
                        </label>
                        <input type="text" value="{{ session.longitude|dash_if_empty }}"
                               class="input input-bordered input-md w-full bg-base-300 cursor-not-allowed text-neutral text-base font-mono"
                               readonly>
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1">
                            <span
                                class="label-text text-sm font-semibold text-neutral opacity-70">{{ 'session.detail.fields.locationSource'|trans }}</span>
                        </label>
                        <input type="text"
                               value="{{ session.locationSource|location_source_config|trans }}"
                               readonly
                               class="input input-bordered input-md w-full bg-base-300 cursor-not-allowed text-neutral text-base"/>
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1 flex justify-between">
                            <span
                                class="label-text text-sm font-semibold text-neutral opacity-70">{{ 'session.detail.fields.accuracy'|trans }}</span>
                        </label>
                        <div class="relative">
                            {% set rounded_accuracy = session.accuracy ? session.accuracy|round(2) : null %}
                            <input type="text"
                                   value="{{ rounded_accuracy !== null ? rounded_accuracy ~ ' m' : '—' }}"
                                   class="input input-bordered input-md w-full cursor-not-allowed text-base font-mono {{ session.accuracy > 100 ? 'border-warning text-warning bg-warning/10' : 'bg-base-300 text-neutral' }}"
                                   readonly>

                            {% if session.accuracy > 100 %}
                                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                    {{ ux_icon('lucide:triangle-alert', {class: 'w-5 h-5 text-warning'}) }}
                                </div>
                            {% endif %}
                        </div>

                        {% if session.accuracy > 100 %}
                            <label class="label py-1 pb-0">
                                <span
                                    class="label-text-alt text-warning font-semibold">{{ 'session.detail.warnings.high_accuracy'|trans }}</span>
                            </label>
                        {% endif %}
                    </div>

                    <div class="form-control w-full">
                        <label class="label py-1">
                            <span
                                class="label-text text-sm font-semibold text-neutral opacity-70">{{ 'session.list.columns.listening_point'|trans }}</span>
                        </label>
                        <input type="number" name="listeningPoint" value="{{ session.listeningPoint }}" min="0"
                               class="input input-bordered input-md w-full text-neutral bg-base-100 text-base"
                               placeholder="—">
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </form>


    <div class="card bg-base-200 border border-base-300 rounded-box shadow-sm mt-6">
        <div class="card-body p-6">
            <h2 class="card-title text-lg md:text-xl font-bold text-neutral mb-2 flex items-center gap-2">
                {{ ux_icon('lucide:map', {class: 'w-5 h-5 text-primary'}) }}
                {{ 'session.detail.section_map'|trans }}
            </h2>

            <div id="session-map-container"
                 class="w-full h-80 rounded-box border border-base-300 overflow-hidden shadow-inner bg-base-100 mt-2"
                 data-controller="map-viewer"
                 data-map-viewer-lat-value="{{ session.latitude }}"
                 data-map-viewer-lng-value="{{ session.longitude }}"
                 data-map-viewer-label-value="LP {{ session.listeningPoint }}"
                 data-map-viewer-icon-url-value="{{ asset('vendor/leaflet/dist/images/marker-icon.png') }}">
            </div>
        </div>
    </div>

    <div class="card bg-base-100 border border-base-300 rounded-box shadow-sm mt-6">
        <div class="card-body p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="card-title text-lg md:text-xl font-bold text-neutral flex items-center gap-2">
                    {{ ux_icon('lucide:bird', {class: 'w-5 h-5 text-primary'}) }}
                    {{ 'session.detail.section_observations'|trans }}
                </h2>
                <span class="badge badge-primary badge-outline badge-lg text-sm font-bold ml-2 shadow-sm">{{ session.observations|length }}</span>
            </div>

            {% if session.observations is empty %}
                <div class="text-center py-12 bg-base-200 rounded-box border border-dashed border-base-300">
                    {{ ux_icon('lucide:search-code', {class: 'w-12 h-12 mx-auto text-base-content opacity-40 mb-3'}) }}
                    <p class="text-base-content opacity-70 text-base">{{ 'session.detail.observations_empty'|trans }}</p>
                </div>
            {% else %}
                <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
                    <table class="table table-lg w-full">
                        <thead class="bg-base-200 text-neutral">
                        <tr>
                            <th class="font-bold text-base md:text-lg">{{ 'session.detail.observation_columns.species'|trans }}</th>
                            <th class="font-bold text-base md:text-lg">{{ 'session.detail.observation_columns.contact'|trans }}</th>
                            <th class="font-bold text-base md:text-lg">{{ 'session.detail.observation_columns.quantity'|trans }}</th>
                            <th class="font-bold text-base md:text-lg">{{ 'session.detail.observation_columns.start_time'|trans }}</th>
                            <th class="font-bold text-base md:text-lg">{{ 'session.detail.observation_columns.end_time'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for obs in session.observations %}
                            <tr class="hover transition-colors cursor-pointer {{ obs.isDeleted ? 'opacity-50 bg-base-200/50' : '' }}"
                                onclick="window.location='{{ path('backoffice_observation_detail', {id: obs.id}) }}'">

                                <td class="text-base md:text-lg font-mono font-medium text-primary">
                                    {{ obs.speciesName|dash_if_empty }}
                                    {% if obs.isDeleted %}
                                        <span
                                            class="badge badge-error badge-sm ml-2">{{ 'session.status.deleted'|trans }}</span>
                                    {% endif %}
                                </td>

                                <td class="text-base md:text-lg">
                                    {% set contact = obs.contactType|contact_type_config %}
                                    <span class="flex items-center gap-1.5 text-neutral">
                                        {{ ux_icon(contact.icon, {class: 'w-4 h-4 opacity-70'}) }}
                                        {{ ('session.detail.contact.' ~ contact.key)|trans }}
                                    </span>
                                </td>

                                <td class="text-base md:text-lg font-semibold text-neutral">{{ obs.quantity }}</td>
                                <td class="text-base md:text-lg font-mono text-neutral">{{ obs.startTime|format_datetime }}</td>
                                <td class="text-base md:text-lg font-mono text-neutral">{{ obs.endTime|format_datetime }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="mt-8 pt-6 flex flex-col-reverse sm:flex-row items-center justify-between gap-4 border-t border-base-200">
        <div class="w-full sm:w-auto">
            {% if not session.isDeleted %}
                <form method="post" action="{{ path('backoffice_session_delete', {id: session.id}) }}"
                      data-controller="confirm-action"
                      data-confirm-action-message-value="Estàs segur que vols enviar aquesta sessió a la paperera?"
                      data-action="submit->confirm-action#confirm">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('session_delete_' ~ session.id) }}">
                    <button type="submit" class="btn btn-outline btn-error w-full sm:w-auto flex items-center justify-center gap-2">
                        {{ ux_icon('lucide:trash-2', {class: 'w-4 h-4'}) }}
                        <span>{{ 'session.action.delete'|trans }}</span>
                    </button>
                </form>
            {% endif %}
        </div>

        <div class="flex flex-col-reverse sm:flex-row items-center gap-3 w-full sm:w-auto">
            <a href="{{ path('backoffice_session_list') }}" class="btn btn-ghost w-full sm:w-auto flex items-center gap-2">
                {{ ux_icon('lucide:x', {class: 'w-4 h-4'}) }}
                {{ 'session.action.cancel'|trans }}
            </a>

            <button type="submit" form="edit-session-form" class="btn btn-primary shadow-sm w-full sm:w-auto flex items-center justify-center gap-2 px-6">
                {{ ux_icon('lucide:save', {class: 'w-4 h-4'}) }}
                {{ 'session.action.save'|trans }}
            </button>
        </div>

    </div>
{% endblock %}
