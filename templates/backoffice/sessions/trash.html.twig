{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'session.trash.title'|trans }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
        <a href="{{ path('backoffice_session_list') }}" class="btn btn-ghost btn-sm">←</a>
        <h1 class="text-2xl font-bold">{{ 'session.trash.title'|trans }}</h1>
        <span class="badge badge-neutral">{{ total }}</span>
    </div>
    {% if total > 0 %}
        <form method="post" action="{{ path('backoffice_session_trash_purge') }}"
              data-controller="confirm-action"
              data-confirm-action-message-value="{{ 'session.trash.confirm_purge'|trans }}"
              data-action="submit->confirm-action#confirm">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('session_purge') }}">
            <button type="submit" class="btn btn-error btn-sm">{{ 'session.trash.purge_button'|trans }}</button>
        </form>
    {% endif %}
</div>

{% if sessions is empty %}
    <div class="alert alert-info">
        <span>{{ 'session.trash.empty'|trans }}</span>
    </div>
{% else %}
    <div class="overflow-x-auto">
        <table class="table table-zebra w-full bg-base-100 shadow-sm rounded-box">
            <thead>
                <tr>
                    <th>{{ 'session.list.col_user'|trans }}</th>
                    <th>{{ 'session.list.col_type'|trans }}</th>
                    <th>{{ 'session.list.col_date'|trans }}</th>
                    <th>Eliminat el</th>
                    <th>{{ 'session.list.col_census'|trans }}</th>
                    <th class="text-right">Accions</th>
                </tr>
            </thead>
            <tbody>
                {% for session in sessions %}
                    <tr>
                        <td class="font-medium">{{ session.annotatorName }}</td>
                        <td>
                            {% if session.sessionType == 0 %}
                                <span class="badge badge-ghost badge-sm">{{ 'session.type.incidental'|trans }}</span>
                            {% elseif session.sessionType == 2 %}
                                <span class="badge badge-info badge-sm">{{ 'session.type.station'|trans }}</span>
                            {% else %}
                                <span class="badge badge-primary badge-sm">{{ 'session.type.census'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="text-sm">{{ session.startTime ?? '—' }}</td>
                        <td class="text-sm">{{ session.deletedAt }}</td>
                        <td class="text-sm">{{ session.censusTitle ?? '—' }}</td>
                        <td class="text-right">
                            <form method="post" action="{{ path('backoffice_session_restore', {id: session.id}) }}"
                                  class="inline"
                                  data-controller="confirm-action"
                                  data-confirm-action-message-value="{{ 'session.confirm.restore'|trans }}"
                                  data-action="submit->confirm-action#confirm">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('session_restore_' ~ session.id) }}">
                                <button type="submit" class="btn btn-ghost btn-xs text-success">
                                    {{ 'session.trash.restore_button'|trans }}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
        <div class="flex justify-center mt-6">
            <div class="join">
                {% if page > 1 %}
                    <a href="{{ path('backoffice_session_trash', {page: page - 1}) }}" class="join-item btn btn-sm">«</a>
                {% endif %}
                {% for p in 1..totalPages %}
                    <a href="{{ path('backoffice_session_trash', {page: p}) }}"
                       class="join-item btn btn-sm {{ p == page ? 'btn-active' : '' }}">{{ p }}</a>
                {% endfor %}
                {% if page < totalPages %}
                    <a href="{{ path('backoffice_session_trash', {page: page + 1}) }}" class="join-item btn btn-sm">»</a>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endif %}
{% endblock %}
