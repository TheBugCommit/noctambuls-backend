{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'observation.detail.title'|trans }} #{{ observation.id|slice(0,8) }}{% endblock %}
{% block page_title %}{{ 'session.nav'|trans }}{% endblock %}

{% block content %}
    <div class="mb-6 sm:mb-8">
        <a href="{{ path('backoffice_session_detail', {id: observation.sessionId}) }}" class="btn btn-ghost btn-sm mb-2 text-base-content/70 hover:text-primary transition-colors flex items-center gap-1.5 w-fit">
            {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4'}) }}
            {{ 'observation.action.back_to_session'|trans }}
        </a>
        <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-2xl md:text-3xl font-bold text-neutral flex items-center gap-2">
                {{ ux_icon('lucide:binoculars', {class: 'w-7 h-7 text-primary'}) }}
                {{ 'observation.detail.title'|trans }}
            </h1>
            <span class="badge badge-outline border-base-300 font-mono text-base-content/60 shadow-sm mt-1">#{{ observation.id|slice(0,8) }}</span>

            {% if observation.isDeleted %}
                <span class="badge badge-error font-medium gap-1.5 mt-1">
                    {{ 'observation.status.deleted'|trans }}
                </span>
            {% endif %}
        </div>
    </div>

    {% if not observation.isDeleted %}
        <form method="post" id="delete-form" action="{{ path('backoffice_observation_delete', {id: observation.id}) }}"
              data-controller="confirm-action"
              data-confirm-action-message-value="{{ 'observation.confirm.delete'|trans }}"
              data-action="submit->confirm-action#confirm">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('observation_delete_' ~ observation.id) }}">
        </form>
    {% else %}
        <form method="post" id="restore-form" action="{{ path('backoffice_observation_restore', {id: observation.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('observation_restore_' ~ observation.id) }}">
        </form>
    {% endif %}

    <form method="post" action="{{ path('backoffice_observation_detail', {id: observation.id}) }}" class="max-w-4xl space-y-6">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('observation_edit') }}">

        <div class="card bg-base-100 shadow-sm border border-base-200">
            <div class="card-body p-6 sm:p-8">
                <h2 class="text-lg font-bold text-neutral mb-5 flex items-center gap-2 border-b border-base-200 pb-2">
                    {{ ux_icon('lucide:clipboard-edit', {class: 'w-5 h-5 text-primary'}) }}
                    {{ 'observation.detail.section_data'|trans }}
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="form-control">
                        <label class="label py-1">
                            <span class="label-text font-semibold text-neutral/80">{{ 'observation.field.species'|trans }}</span>
                        </label>
                        <select name="speciesId" class="select select-bordered w-full bg-base-200/30 focus:bg-base-100 transition-colors font-medium">
                            {% for bird in birds %}
                                <option value="{{ bird.id }}" {{ observation.speciesId == bird.id ? 'selected' : '' }}>
                                    {{ bird.scientificName }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-control">
                        <label class="label py-1">
                            <span class="label-text font-semibold text-neutral/80">{{ 'observation.field.contact_type'|trans }}</span>
                        </label>
                        <select name="contactType" class="select select-bordered w-full bg-base-200/30 focus:bg-base-100 transition-colors">
                            <option value="0" {{ observation.contactType == 0 ? 'selected' : '' }}>{{ 'observation.contact.visual'|trans }}</option>
                            <option value="1" {{ observation.contactType == 1 ? 'selected' : '' }}>{{ 'observation.contact.auditory'|trans }}</option>
                        </select>
                    </div>

                    <div class="form-control">
                        <label class="label py-1">
                            <span class="label-text font-semibold text-neutral/80">{{ 'observation.field.quantity'|trans }}</span>
                        </label>
                        <div class="relative">
                            <input type="number" name="quantity" value="{{ observation.quantity }}" min="1"
                                   class="input input-bordered w-full bg-base-200/30 focus:bg-base-100 transition-colors pl-10">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:hash', {class: 'w-4 h-4 text-base-content/40'}) }}
                            </div>
                        </div>
                    </div>

                    <div class="form-control">
                        <label class="label py-1">
                            <span class="label-text font-semibold text-neutral/80">{{ 'observation.field.bearing'|trans }}</span>
                        </label>
                        <div class="relative">
                            <input type="number" name="bearing" value="{{ observation.bearing }}" min="0" max="359.99" step="0.01"
                                   class="input input-bordered w-full bg-base-200/30 focus:bg-base-100 transition-colors pl-10">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                {{ ux_icon('lucide:compass', {class: 'w-4 h-4 text-base-content/40'}) }}
                            </div>
                        </div>
                    </div>

                    <div class="form-control md:col-span-2">
                        <label class="label py-1">
                            <span class="label-text font-semibold text-neutral/80">{{ 'observation.field.notes'|trans }}</span>
                        </label>
                        <textarea name="notes" class="textarea textarea-bordered bg-base-200/30 focus:bg-base-100 transition-colors leading-relaxed" rows="3">{{ observation.notes }}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm border border-base-200">
            <div class="card-body p-6 sm:p-8">
                <h2 class="text-lg font-bold text-neutral mb-5 flex items-center gap-2 border-b border-base-200 pb-2">
                    {{ ux_icon('lucide:clock', {class: 'w-5 h-5 text-primary'}) }}
                    {{ 'observation.detail.section_temporal'|trans }}
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold text-base-content/60 uppercase tracking-wider">{{ 'observation.field.start_time'|trans }}</span>
                        <div class="flex items-center gap-2 font-medium bg-base-200/50 p-2.5 rounded-lg border border-base-200 text-sm">
                            {{ ux_icon('lucide:play-circle', {class: 'w-4 h-4 text-base-content/50'}) }}
                            <span>{{ observation.startTime|format_datetime }}</span>
                        </div>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold text-base-content/60 uppercase tracking-wider">{{ 'observation.field.end_time'|trans }}</span>
                        <div class="flex items-center gap-2 font-medium bg-base-200/50 p-2.5 rounded-lg border border-base-200 text-sm">
                            {{ ux_icon('lucide:stop-circle', {class: 'w-4 h-4 text-base-content/50'}) }}
                            <span>{{ observation.endTime|format_datetime }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm border border-base-200">
            <div class="card-body p-6 sm:p-8">
                <h2 class="text-lg font-bold text-neutral mb-5 flex items-center gap-2 border-b border-base-200 pb-2">
                    {{ ux_icon('lucide:map-pin', {class: 'w-5 h-5 text-primary'}) }}
                    {{ 'observation.detail.section_location'|trans }}
                </h2>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-5">
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold text-base-content/60 uppercase tracking-wider">{{ 'observation.field.latitude'|trans }}</span>
                        <div class="flex items-center gap-2 font-mono text-sm bg-base-200/50 p-2.5 rounded-lg border border-base-200">
                            <span>{{ observation.latitude|dash_if_empty }}</span>
                        </div>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold text-base-content/60 uppercase tracking-wider">{{ 'observation.field.longitude'|trans }}</span>
                        <div class="flex items-center gap-2 font-mono text-sm bg-base-200/50 p-2.5 rounded-lg border border-base-200">
                            <span>{{ observation.longitude|dash_if_empty }}</span>
                        </div>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold text-base-content/60 uppercase tracking-wider">{{ 'observation.field.accuracy'|trans }}</span>
                        {% set rounded_acc = observation.accuracy ? observation.accuracy|round(2) : null %}
                        <div class="flex items-center gap-2 font-mono text-sm p-2.5 rounded-lg border {{ observation.accuracy > 100 ? 'border-warning bg-warning/10 text-warning' : 'bg-base-200/50 border-base-200' }}">
                            <span>{{ rounded_acc is not null ? rounded_acc ~ ' m' : '—' }}</span>
                            {% if observation.accuracy > 100 %}
                                {{ ux_icon('lucide:triangle-alert', {class: 'w-4 h-4 text-warning ml-auto shrink-0'}) }}
                            {% endif %}
                        </div>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold text-base-content/60 uppercase tracking-wider">{{ 'observation.field.location_source'|trans }}</span>
                        <div class="flex items-center gap-2 text-sm bg-base-200/50 p-2.5 rounded-lg border border-base-200">
                            <span>{{ observation.locationSource is not null ? observation.locationSource|location_source_config|trans : '—' }}</span>
                        </div>
                    </div>
                </div>

                {% if observation.sessionType == 0 %}
                    <p class="text-sm text-neutral opacity-60 mb-2">{{ 'observation.detail.map_click_hint'|trans }}</p>
                    <div data-controller="session-location-map"
                         data-session-location-map-icon-url-value="{{ asset('vendor/leaflet/dist/images/marker-icon.png') }}"
                         data-session-location-map-icon-retina-value="{{ asset('vendor/leaflet/dist/images/marker-icon.png') }}">
                        <div class="w-full rounded-xl overflow-hidden border border-base-300 shadow-inner"
                             style="height: 350px;"
                             data-session-location-map-target="map">
                        </div>
                        <input type="hidden" name="latitude"       value="{{ observation.latitude }}"       data-session-location-map-target="lat">
                        <input type="hidden" name="longitude"      value="{{ observation.longitude }}"      data-session-location-map-target="lng">
                        <input type="hidden" name="accuracy"       value="{{ observation.accuracy }}"       data-session-location-map-target="accuracy">
                        <input type="hidden" name="locationSource" value="{{ observation.locationSource }}" data-session-location-map-target="locationSource">
                    </div>
                {% else %}
                    {% if observation.latitude and observation.longitude %}
                        <div class="rounded-xl overflow-hidden border border-base-300 shadow-inner">
                            <div data-controller="map-viewer"
                                 data-map-viewer-lat-value="{{ observation.latitude }}"
                                 data-map-viewer-lng-value="{{ observation.longitude }}"
                                 data-map-viewer-label-value="{{ 'observation.detail.title'|trans }}"
                                 data-map-viewer-icon-url-value="{{ asset('vendor/leaflet/dist/images/marker-icon.png') }}"
                                 style="height: 350px;" class="w-full z-0">
                            </div>
                        </div>
                    {% else %}
                        <div class="flex items-center gap-3 bg-base-200/50 p-4 rounded-lg border border-base-200 text-base-content/70">
                            {{ ux_icon('lucide:map-x', {class: 'w-5 h-5 shrink-0'}) }}
                            <span>{{ 'observation.detail.no_location'|trans }}</span>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        <div class="mt-8 pt-6 flex flex-col-reverse sm:flex-row items-center justify-between gap-4 border-t border-transparent">
            <div class="w-full sm:w-auto">
                {% if not observation.isDeleted %}
                    <button type="submit" form="delete-form" class="btn btn-outline btn-error w-full sm:w-auto flex items-center justify-center gap-2">
                        {{ ux_icon('lucide:trash-2', {class: 'w-4 h-4'}) }}
                        <span>{{ 'observation.action.delete'|trans }}</span>
                    </button>
                {% else %}
                    <button type="submit" form="restore-form" class="btn btn-outline btn-success w-full sm:w-auto flex items-center justify-center gap-2">
                        {{ ux_icon('lucide:undo-2', {class: 'w-4 h-4'}) }}
                        <span>{{ 'observation.action.restore'|trans }}</span>
                    </button>
                {% endif %}
            </div>

            <div class="flex flex-col-reverse sm:flex-row items-center gap-3 w-full sm:w-auto">
                <a href="{{ path('backoffice_session_detail', {id: observation.sessionId}) }}" class="btn btn-ghost w-full sm:w-auto flex items-center gap-2">
                    {{ ux_icon('lucide:x', {class: 'w-4 h-4'}) }}
                    {{ 'census.action.cancel'|trans|default('Cancel·lar') }}
                </a>
                {% if not observation.isDeleted %}
                    <button type="submit" class="btn btn-primary w-full sm:w-auto shadow-sm flex items-center gap-2">
                        {{ ux_icon('lucide:save', {class: 'w-4 h-4'}) }}
                        {{ 'census.action.save'|trans }}
                    </button>
                {% endif %}
            </div>
        </div>
    </form>
{% endblock %}
