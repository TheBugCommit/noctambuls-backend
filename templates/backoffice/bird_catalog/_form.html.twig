{#
Variables expected:
- csrf_token_value: string
- bird (optional): GetBirdResponse — pre-fills fields on edit
- data (optional): raw POST array — re-fills on validation error
#}

{% set bird = bird ?? null %}
{% set data = data ?? {} %}

<input type="hidden" name="_csrf_token" value="{{ csrf_token_value }}">

<div class="card bg-base-100 shadow-sm mb-6">
    <div class="card-body">
        <h2 class="card-title text-lg mb-4">{{ 'bird_catalog.section.details'|trans }}</h2>

        <div class="form-control mb-3">
            <label class="label" for="scientificName">
                <span class="label-text">{{ 'bird_catalog.field.scientific_name'|trans }}</span>
            </label>
            <input id="scientificName" type="text" name="scientificName"
                   value="{{ data.scientificName ?? (bird ? bird.scientificName : '') }}"
                   class="input input-bordered" required>
        </div>

        <div class="form-control mb-3">
            <label class="label" for="imageFile">
                <span class="label-text">{{ 'bird_catalog.field.image_path'|trans }} (WebP, min 1500px amplada)</span>
            </label>
            {% if bird and bird.imagePath %}
                <div class="mb-2">
                    <img src="{{ bird.imagePath }}" alt="Imatge actual" class="h-32 w-auto object-cover rounded shadow">
                    <input type="hidden" name="currentImagePath" value="{{ bird.imagePath }}">
                </div>
            {% endif %}
            <input id="imageFile" type="file" name="imageFile" accept="image/webp"
                   class="file-input file-input-bordered w-full" {{ not bird ? 'required' : '' }}>
        </div>
        <div class="form-control mb-3">
            <label class="label" for="audioFile">
                <span class="label-text">{{ 'bird_catalog.field.audio_path'|trans }} (OGG, màx 400KB)</span>
            </label>
            {% if bird and bird.audioPath %}
                <div class="mb-2 mt-2">
                    <audio controls src="{{ bird.audioPath }}" class="w-full max-w-md"></audio>
                    <input type="hidden" name="currentAudioPath" value="{{ bird.audioPath }}">
                </div>
            {% endif %}
            <input id="audioFile" type="file" name="audioFile" accept="audio/ogg"
                   class="file-input file-input-bordered w-full" {{ not bird ? 'required' : '' }}>
        </div>
        <div class="form-control mb-3">
            <label class="label" for="informationUrl">
                <span class="label-text">{{ 'bird_catalog.field.information_url'|trans }}</span>
            </label>
            <input id="informationUrl" type="url" name="informationUrl"
                   value="{{ data.informationUrl ?? (bird ? bird.informationUrl : '') }}"
                   class="input input-bordered" required>
        </div>
    </div>
</div>

<div class="card bg-base-100 shadow-sm mb-6">
    <div class="card-body">
        <h2 class="card-title text-lg mb-4">{{ 'bird_catalog.section.translations'|trans }}</h2>

        {% set languages = enum('App\\BirdCatalog\\Domain\\ValueObject\\LanguageCode').cases %}

        {% set existingTranslations = {} %}
        {% if bird %}
            {% for t in bird.translations %}
                {% set existingTranslations = existingTranslations|merge({(t.languageCode): t}) %}
            {% endfor %}
        {% endif %}

        <div role="tablist" class="tabs tabs-bordered mb-4">
            {% for lang in languages %}
                <input type="radio" name="translation_tabs" role="tab"
                       class="tab" aria-label="{{ ('language.' ~ lang.value)|trans }}"
                    {{ loop.first ? 'checked' : '' }}>
                <div role="tabpanel" class="tab-content pt-4">
                    <div class="form-control mb-3">
                        <label class="label">
                            <span class="label-text">{{ 'bird_catalog.field.common_name'|trans }}</span>
                        </label>

                        {% set submittedCommon = data.translations[lang.value].commonName ?? null %}
                        {% set existingCommon = existingTranslations[lang.value].commonName ?? '' %}

                        <input type="text"
                               name="translations[{{ lang.value }}][commonName]"
                               value="{{ submittedCommon is not empty ? submittedCommon : existingCommon }}"
                               class="input input-bordered" required>
                    </div>
                    <div class="form-control mb-3">
                        <label class="label">
                            <span class="label-text">{{ 'bird_catalog.field.description'|trans }}</span>
                        </label>
                        {% set submittedDesc = data.translations[lang.value].description ?? null %}
                        {% set existingDesc = existingTranslations[lang.value].description ?? '' %}

                        <textarea name="translations[{{ lang.value }}][description]"
                                  class="textarea textarea-bordered h-28" required
                        >{{ submittedDesc is not empty ? submittedDesc : existingDesc }}</textarea>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
