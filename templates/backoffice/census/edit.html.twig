{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'census.edit.title'|trans }}: {{ census.title }}{% endblock %}

{% block content %}
<div class="flex items-center gap-4 mb-6">
    <a href="{{ path('backoffice_census_list') }}" class="btn btn-ghost btn-sm">← {{ 'census.action.back'|trans }}</a>
    <h1 class="text-2xl font-bold">{{ 'census.edit.title'|trans }}: {{ census.title }}</h1>
</div>

{% if not census.isEditable %}
    <div class="alert alert-warning mb-4">
        <span>{{ 'census.error.not_editable'|trans }}</span>
    </div>
{% endif %}

<div class="card bg-base-100 shadow-sm max-w-2xl">
    <div class="card-body">
        <form method="post" action="{{ path('backoffice_census_edit', {id: census.id}) }}">
            {% include 'backoffice/census/_form.html.twig' %}

            <div class="flex gap-2 justify-end">
                <a href="{{ path('backoffice_census_list') }}" class="btn btn-ghost btn-sm">
                    {{ 'census.action.cancel'|trans }}
                </a>
                <button type="submit" class="btn btn-primary btn-sm" {{ not census.isEditable ? 'disabled' : '' }}>
                    {{ 'census.action.save'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
