{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'census.edit.title'|trans }}: {{ census.title }}{% endblock %}
{% block page_title %}{{ 'census.nav'|trans }}{% endblock %}

{% block content %}
    <div class="mb-6 sm:mb-8">
        <a href="{{ path('backoffice_census_list') }}" class="btn btn-ghost btn-sm mb-2 text-base-content/70 hover:text-primary transition-colors flex items-center gap-1.5 w-fit">
            {{ ux_icon('lucide:arrow-left', {class: 'w-4 h-4'}) }}
            {{ 'census.action.back'|trans }}
        </a>
        <h1 class="text-2xl md:text-3xl font-bold text-neutral flex flex-wrap items-center gap-x-3 gap-y-1">
            {{ ux_icon('lucide:pencil', {class: 'w-7 h-7 text-primary shrink-0'}) }}
            <span>{{ 'census.edit.title'|trans }}:</span>
            <span class="italic font-medium text-base-content/60">{{ census.title }}</span>
            <span class="badge badge-outline font-mono text-xs opacity-70">#{{ census.id|slice(0,8) }}</span>

        </h1>
    </div>

    {% if not census.isEditable %}
        <div class="alert alert-warning shadow-sm border border-warning/20 mb-6 max-w-4xl flex items-start gap-3">
            {{ ux_icon('lucide:triangle-alert', {class: 'w-5 h-5 shrink-0 mt-0.5'}) }}
            <span class="font-medium text-sm">{{ 'census.error.not_editable'|trans }}</span>
        </div>
    {% endif %}

    <div class="card bg-base-100 shadow-sm border border-base-200 max-w-4xl">
        <form method="post" action="{{ path('backoffice_census_edit', {id: census.id}) }}">
            <div class="card-body p-6 sm:p-8">

                {% include 'backoffice/census/_form.html.twig' %}

                <div class="mt-8 pt-6 border-t border-base-200 flex flex-col-reverse sm:flex-row items-center justify-end gap-3">
                    <a href="{{ path('backoffice_census_list') }}" class="btn btn-ghost w-full sm:w-auto flex items-center justify-center gap-2">
                        {{ ux_icon('lucide:x', {class: 'w-4 h-4'}) }}
                        {{ 'census.action.cancel'|trans }}
                    </a>

                    <button type="submit"
                            class="btn btn-primary w-full sm:w-auto shadow-sm flex items-center justify-center gap-2"
                        {{ not census.isEditable ? 'disabled' : '' }}>
                        {{ ux_icon('lucide:save', {class: 'w-4 h-4'}) }}
                        {{ 'census.action.save'|trans }}
                    </button>
                </div>

            </div>
        </form>
    </div>
{% endblock %}
