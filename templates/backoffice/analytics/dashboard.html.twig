{% extends 'backoffice/layout.html.twig' %}

{% block title %}{{ 'analytics.dashboard.title'|trans }}{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">{{ 'analytics.dashboard.title'|trans }}</h1>
    <form method="post" action="{{ path('backoffice_analytics_force_update') }}"
          data-controller="confirm-action"
          data-confirm-action-message-value="{{ 'analytics.dashboard.confirm_update'|trans }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('analytics_force_update') }}">
        <button type="submit" class="btn btn-primary btn-sm" data-action="confirm-action#confirm">
            {{ 'analytics.dashboard.force_update'|trans }}
        </button>
    </form>
</div>

<div class="grid grid-cols-1 gap-4 mb-8">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="card-title text-sm text-base-content/60">{{ 'analytics.dashboard.last_update'|trans }}</h2>
            <p class="text-lg font-semibold">
                {% if lastProcessedAt %}
                    {{ lastProcessedAt|date('d/m/Y H:i:s') }} UTC
                {% else %}
                    {{ 'analytics.dashboard.never'|trans }}
                {% endif %}
            </p>
        </div>
    </div>
</div>

<div class="card bg-base-100 shadow-sm" data-controller="chart-tabs">
    <div class="card-body">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
            <div role="tablist" class="tabs tabs-bordered">
                <button role="tab" class="tab tab-active"
                        data-chart-tabs-target="tab"
                        data-chart-tabs-name-param="monthly"
                        data-action="click->chart-tabs#switch">
                    {{ 'analytics.dashboard.tab.monthly'|trans }}
                </button>
                <button role="tab" class="tab"
                        data-chart-tabs-target="tab"
                        data-chart-tabs-name-param="percentage"
                        data-action="click->chart-tabs#switch">
                    {{ 'analytics.dashboard.tab.percentage'|trans }}
                </button>
            </div>

            <form method="get" action="{{ path('backoffice_analytics_dashboard') }}" class="flex items-center gap-2">
                <label for="year-filter" class="text-sm font-medium">
                    {{ 'analytics.dashboard.chart.year_filter'|trans }}
                </label>
                <select id="year-filter" name="year" class="select select-bordered select-sm">
                    {% for year in availableYears %}
                        <option value="{{ year }}" {% if year == selectedYear %}selected{% endif %}>{{ year }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-sm btn-outline">
                    {{ 'analytics.dashboard.chart.apply'|trans }}
                </button>
            </form>
        </div>

        {# Panel: Observacions per mes #}
        <div data-chart-tabs-target="panel" data-chart-tabs-panel-name="monthly">
            {% if chartData.series is empty %}
                <p class="text-base-content/60 text-sm py-8 text-center">
                    {{ 'analytics.dashboard.chart.no_data'|trans }}
                </p>
            {% else %}
                {% set monthLabels = [] %}
                {% for i in 1..12 %}
                    {% set monthLabels = monthLabels|merge([('analytics.dashboard.chart.month.' ~ i)|trans]) %}
                {% endfor %}
                <canvas
                    data-controller="observations-chart"
                    data-observations-chart-chart-data-value="{{ chartData|json_encode|e('html_attr') }}"
                    data-observations-chart-month-labels-value="{{ monthLabels|json_encode|e('html_attr') }}"
                ></canvas>
            {% endif %}
        </div>

        {# Panel: % per espècie #}
        <div class="hidden" data-chart-tabs-target="panel" data-chart-tabs-panel-name="percentage">
            {% if percentageData.labels is empty %}
                <p class="text-base-content/60 text-sm py-8 text-center">
                    {{ 'analytics.dashboard.percentage_chart.no_data'|trans }}
                </p>
            {% else %}
                <canvas
                    data-controller="species-percentage-chart"
                    data-species-percentage-chart-labels-value="{{ percentageData.labels|json_encode|e('html_attr') }}"
                    data-species-percentage-chart-data-value="{{ percentageData.data|json_encode|e('html_attr') }}"
                    data-species-percentage-chart-colors-value="{{ percentageData.colors|json_encode|e('html_attr') }}"
                ></canvas>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
