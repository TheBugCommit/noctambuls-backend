{% extends 'base.html.twig' %}

{% block title %}{{ 'page_title.title'|trans }}{{ 'page_title.ref'|trans }}{% endblock %}
{% block body %}
    <body class="min-h-screen bg-base-200">

    <div class="navbar bg-base-100 shadow-sm px-4">
        <div class="flex-1">
            <span class="text-lg font-bold">{{ 'nav.title'|trans }}</span>
        </div>
        <div class="flex-none gap-2">
            <a href="{{ path('backoffice_census_list') }}" class="btn btn-ghost btn-sm">
                {{ 'census.nav'|trans }}
            </a>
            <a href="{{ path('backoffice_bird_catalog_list') }}" class="btn btn-ghost btn-sm">
                {{ 'bird_catalog.nav'|trans }}
            </a>
            <a href="{{ path('backoffice_users_list') }}" class="btn btn-ghost btn-sm">
                {{ 'user_management.nav.app_users'|trans }}
            </a>
            <a href="{{ path('backoffice_backoffice_users_list') }}" class="btn btn-ghost btn-sm">
                {{ 'user_management.nav.backoffice_users'|trans }}
            </a>
            <a href="{{ path('backoffice_logout') }}" class="btn btn-ghost btn-sm">
                {{ 'nav.logout'|trans }}
            </a>
        </div>
    </div>

    <main class="container mx-auto px-4 py-8 max-w-5xl">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'error' : 'success' }} mb-4">
                    <span>{{ message|trans }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
    </main>

    </body>
{% endblock %}
