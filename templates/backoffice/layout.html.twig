<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'page_title.title'|trans }}{% endblock %} {{ 'page_title.ref'|trans }}</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4/dist/full.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-base-200">

<div class="navbar bg-base-100 shadow-sm px-4">
    <div class="flex-1">
        <span class="text-lg font-bold">{{ 'nav.title'|trans }}</span>
    </div>
    <div class="flex-none gap-2">
        <a href="{{ path('backoffice_bird_catalog_list') }}" class="btn btn-ghost btn-sm">
            {{ 'bird_catalog.nav'|trans }}
        </a>
        <a href="{{ path('backoffice_logout') }}" class="btn btn-ghost btn-sm">
            {{ 'nav.logout'|trans }}
        </a>
    </div>
</div>

<main class="container mx-auto px-4 py-8 max-w-5xl">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'error' : 'success' }} mb-4">
                <span>{{ message|trans }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
</main>

</body>
</html>
