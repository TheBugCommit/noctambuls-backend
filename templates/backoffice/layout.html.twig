{% extends 'base.html.twig' %}

{% block title %}{{ 'page_title.title'|trans }}{{ 'page_title.ref'|trans }}{% endblock %}

{% block body %}
    {% set current_route = app.request.attributes.get('_route') %}
    {% set menu_items = [
        { label: 'session.nav', route: 'backoffice_session_list', prefix: 'backoffice_session', icon: 'lucide:calendar', role: null },
        { label: 'census.nav', route: 'backoffice_census_list', prefix: 'backoffice_census', icon: 'lucide:clipboard-list', role: 'ROLE_ADMIN' },
        { label: 'bird_catalog.nav', route: 'backoffice_bird_catalog_list', prefix: 'backoffice_bird_catalog', icon: 'lucide:bird', role: 'ROLE_ADMIN' },
        { label: 'user_management.nav.app_users', route: 'backoffice_users_list', prefix: 'backoffice_users', icon: 'lucide:users', role: 'ROLE_ADMIN' },
        { label: 'user_management.nav.backoffice_users', route: 'backoffice_backoffice_users_list', prefix: 'backoffice_backoffice_users', icon: 'lucide:user-cog', role: 'ROLE_ADMIN' },
        { label: 'analytics.nav', route: 'backoffice_analytics_dashboard', prefix: 'backoffice_analytics', icon: 'lucide:bar-chart-2', role: 'ROLE_ADMIN' },
        { label: 'notification.nav', route: 'backoffice_notifications', prefix: 'backoffice_notifications', icon: 'lucide:bell', role: 'ROLE_ADMIN' }
    ] %}

    <body class="bg-base-200 flex h-screen overflow-hidden w-full" data-controller="sidebar">

    <aside data-sidebar-target="menu"
           class="bg-base-100 w-64 flex-shrink-0 border-r shadow-lg absolute inset-y-0 left-0 transform -translate-x-full transition-transform duration-300 ease-in-out z-50 md:relative md:translate-x-0 flex flex-col">

        <div class="h-16 flex items-center justify-between px-4 border-b">
                <span class="text-xl font-bold text-primary flex items-center gap-2">
                    {{ 'nav.title'|trans }}
                </span>
            <button data-action="sidebar#toggle" class="btn btn-sm btn-ghost md:hidden">✕</button>
        </div>

        <nav class="flex-1 overflow-y-auto p-4 space-y-1">
            {% for item in menu_items %}
                {% if item.role is null or is_granted(item.role) %}

                    {% set is_active = current_route starts with item.prefix %}

                    <a href="{{ path(item.route) }}"
                       class="btn justify-start w-full font-normal flex items-center gap-3 {{ is_active ? 'btn-active text-primary' : 'btn-ghost text-base-content' }}">

                        {{ ux_icon(item.icon, {class: 'w-5 h-5 ' ~ (is_active ? 'text-primary' : 'opacity-70')}) }}
                        <span>{{ item.label|trans }}</span>
                    </a>

                {% endif %}
            {% endfor %}
        </nav>

        <div class="p-4 border-t">
            <a href="{{ path('backoffice_logout') }}" class="btn btn-outline btn-error w-full flex items-center gap-2">
                {{ ux_icon('lucide:log-out', {class: 'w-4 h-4'}) }}
                {{ 'nav.logout'|trans }}
            </a>
        </div>
    </aside>

    <div data-sidebar-target="overlay" data-action="click->sidebar#toggle"
         class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden md:hidden"></div>

    <div class="flex-1 flex flex-col h-screen min-w-0">
        <header class="h-16 bg-base-100 shadow-sm flex items-center px-4 z-10 border-b">
            <button data-action="sidebar#toggle" class="btn btn-square btn-ghost mr-3 md:hidden">
                {{ ux_icon('lucide:menu', {class: 'w-6 h-6'}) }}
            </button>

            <div class="flex-1 font-semibold text-xl text-neutral">
                {% block page_title %}Tauler de control{% endblock %}
            </div>

            <button data-controller="theme" data-action="click->theme#toggle" class="btn btn-ghost btn-circle"
                    aria-label="Canviar tema">
                <div data-theme-target="moon" class="hidden text-neutral">
                    {{ ux_icon('lucide:moon', {class: 'w-5 h-5'}) }}
                </div>

                <div data-theme-target="sun" class="hidden text-warning">
                    {{ ux_icon('lucide:sun', {class: 'w-5 h-5'}) }}
                </div>
            </button>
        </header>

        <main class="flex-1 overflow-y-auto p-4 md:p-8 bg-base-200">
            <div class="max-w-6xl mx-auto">
                <div class="bg-base-100 rounded-box shadow-sm p-6">
                    {% block content %}{% endblock %}
                </div>
            </div>
        </main>

        <div class="fixed bottom-4 right-4 z-[100] p-0 pointer-events-none flex flex-col items-end gap-3 w-full max-w-xs sm:max-w-sm">
            {% for label, messages in app.flashes %}

                {% set config = label == 'error'
                    ? { border: 'border-l-error', iconColor: 'text-error', icon: 'lucide:x-circle' }
                    : (label == 'success'
                    ? { border: 'border-l-success', iconColor: 'text-success', icon: 'lucide:check-circle' }
                    : (label == 'warning'
                    ? { border: 'border-l-warning', iconColor: 'text-warning', icon: 'lucide:triangle-alert' }
                    : { border: 'border-l-info', iconColor: 'text-info', icon: 'lucide:info' })) %}

                {% for message in messages %}
                    <div class="flex items-start sm:items-center gap-3 p-4 bg-base-100 text-base-content border border-base-300 border-l-4 {{ config.border }} shadow-2xl rounded-box transition-all duration-500 ease-in-out transform translate-x-full opacity-0 pointer-events-auto w-full"
                         data-controller="flash"
                         data-flash-timeout-value="5000">
                        {{ ux_icon(config.icon, {class: 'w-5 h-5 shrink-0 ' ~ config.iconColor}) }}

                        <div class="flex-1 text-sm font-medium leading-snug">
                            {{ message|trans }}
                        </div>

                        <button class="btn btn-ghost btn-xs btn-circle shrink-0 opacity-40 hover:opacity-100 text-base-content"
                                data-action="click->flash#close"
                                aria-label="Tancar">
                            {{ ux_icon('lucide:x', {class: 'w-3.5 h-3.5'}) }}
                        </button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <dialog id="custom_confirm_modal" class="modal modal-bottom sm:modal-middle">
            <div class="modal-box bg-base-100 shadow-2xl border border-base-200">
                <h3 class="font-bold text-lg flex items-center gap-2 text-neutral">
                    {{ ux_icon('lucide:triangle-alert', {class: 'w-6 h-6 text-warning'}) }}
                    {{ 'modal.confirm.title'|trans|default('Atenció: Confirmació requerida') }}
                </h3>
                <p class="py-5 text-base-content/80 text-base leading-relaxed" id="custom_confirm_modal_message"></p>
                <div class="modal-action mt-2 flex gap-2">
                    <button class="btn btn-ghost flex-1" id="custom_confirm_modal_cancel">
                        {{ 'modal.confirm.cancel'|trans|default('Cancel·lar') }}
                    </button>
                    <button class="btn btn-error shadow-sm flex-1 text-white" id="custom_confirm_modal_confirm">
                        {{ 'modal.confirm.accept'|trans|default('Sí, procedir') }}
                    </button>
                </div>
            </div>
            <form method="dialog" class="modal-backdrop">
                <button>Tancar</button>
            </form>
        </dialog>
    </div>
    </body>
{% endblock %}
